{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Asanagi",
  "version": "0.2.2",
  "identifier": "com.foresthill.asanagi",
  "build": {
    "beforeBuildCommand": "npm run build:standalone",
    "frontendDist": "splash",
    "devUrl": "http://localhost:3100"
  },
  "app": {
    "windows": [
      {
        "title": "Asanagi",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "createUpdaterArtifacts": false,
    "resources": {
      "../.next-standalone/standalone": "server",
      "binaries/node": "node"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/foresthill/asanagi-mailer-ai/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBLIC_KEY"
    }
  }
}
